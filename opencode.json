{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "deny",
      "uv run pytest*": "allow",
      "uv run python scripts/*": "allow",
      "ls*": "allow",
      "git status*": "allow",
      "git diff*": "allow"
    }
  }
}
